{
  "rules": {
    ".read": false,
    ".write": false,
    "matches": {
      ".read": "auth != null && auth.token.email === 'emmanuelasaber@gmail.com' && auth.token.email_verified === true",
      "$game": {
        "$code": {
          ".read": "auth != null",
          ".write": "auth != null && $game.matches(/^[a-z0-9]{2,20}$/) && $code.matches(/^[A-Z]{4}$/) && ((!data.exists() && newData.child('hostId').val() === auth.uid && newData.child('seats/s0').val() === auth.uid && newData.child('status').val() === 'waiting') || (data.exists() && !newData.exists() && ((data.child('status').val() === 'waiting' && data.child('hostId').val() === auth.uid) || (data.child('status').val() === 'abandoned' && data.child('players').hasChild(auth.uid)) || data.child('createdAt').val() < now - 86400000)))",
          "game": {
            ".validate": "newData.val() === $game"
          },
          "code": {
            ".validate": "newData.val() === $code"
          },
          "hostId": {
            ".write": "auth != null && newData.val() === auth.uid && data.parent().child('status').val() === 'playing' && data.parent().child('players').hasChild(auth.uid) && data.parent().child('out').hasChild(data.val()) && !data.parent().child('out').hasChild(auth.uid)",
            ".validate": "newData.isString()"
          },
          "seatCount": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4 && (!data.exists() || newData.val() === data.val())"
          },
          "out": {
            "$uid": {
              ".write": "auth != null && !data.exists() && root.child('matches/' + $game + '/' + $code).child('status').val() === 'playing' && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid) && root.child('matches/' + $game + '/' + $code).child('players').hasChild($uid)",
              ".validate": "newData.val() === 'left' || newData.val() === 'dropped'"
            }
          },
          "stake": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && data.parent().child('status').val() === 'waiting'",
            ".validate": "newData.hasChildren(['text', 'format'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32"
            },
            "format": {
              ".validate": "newData.val() === 'winner' || newData.val() === 'last'"
            },
            "$other": {
              ".validate": false
            }
          },
          "stakeOk": {
            ".write": "auth != null && !newData.exists() && data.parent().child('hostId').val() === auth.uid && data.parent().child('status').val() === 'waiting'",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('matches/' + $game + '/' + $code).child('status').val() === 'waiting' && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)",
              ".validate": "newData.isString() && newData.val().length <= 32"
            }
          },
          "stakeDone": {
            ".write": "auth != null && data.parent().child('status').val() === 'playing' && data.parent().child('players').hasChild(auth.uid)",
            ".validate": "newData.isNumber() && newData.val() === data.parent().child('startedAt').val()"
          },
          "stakeLeft": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('matches/' + $game + '/' + $code).child('status').val() === 'playing' && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)",
              ".validate": "newData.isNumber() && newData.val() === root.child('matches/' + $game + '/' + $code).child('startedAt').val()"
            }
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "seats": {
            "s0": {
              ".validate": "newData.isString()"
            },
            "s1": {
              ".write": "auth != null && root.child('matches/' + $game + '/' + $code).child('status').val() === 'waiting' && ((!data.exists() && newData.val() === auth.uid && data.parent().child('s0').val() !== auth.uid && data.parent().child('s2').val() !== auth.uid && data.parent().child('s3').val() !== auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
              ".validate": "newData.isString()"
            },
            "s2": {
              ".write": "auth != null && root.child('matches/' + $game + '/' + $code).child('status').val() === 'waiting' && root.child('matches/' + $game + '/' + $code).child('seatCount').val() >= 3 && ((!data.exists() && newData.val() === auth.uid && data.parent().child('s0').val() !== auth.uid && data.parent().child('s1').val() !== auth.uid && data.parent().child('s3').val() !== auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
              ".validate": "newData.isString()"
            },
            "s3": {
              ".write": "auth != null && root.child('matches/' + $game + '/' + $code).child('status').val() === 'waiting' && root.child('matches/' + $game + '/' + $code).child('seatCount').val() >= 4 && ((!data.exists() && newData.val() === auth.uid && data.parent().child('s0').val() !== auth.uid && data.parent().child('s1').val() !== auth.uid && data.parent().child('s2').val() !== auth.uid) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)))",
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          },
          "players": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || newData.parent().parent().child('seats/s0').val() === auth.uid || newData.parent().parent().child('seats/s1').val() === auth.uid || newData.parent().parent().child('seats/s2').val() === auth.uid || newData.parent().parent().child('seats/s3').val() === auth.uid)",
              ".validate": "newData.hasChildren(['name', 'seat'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "seat": {
                ".validate": "(newData.val() === 0 && newData.parent().parent().parent().child('seats/s0').val() === $uid) || (newData.val() === 1 && newData.parent().parent().parent().child('seats/s1').val() === $uid) || (newData.val() === 2 && newData.parent().parent().parent().child('seats/s2').val() === $uid) || (newData.val() === 3 && newData.parent().parent().parent().child('seats/s3').val() === $uid)"
              },
              "online": {
                ".validate": "newData.isBoolean()"
              },
              "joinedAt": {
                ".validate": "newData.isNumber()"
              },
              "look": {
                ".validate": "newData.isString() && newData.val().matches(/^(screen|bot|cyclops|die|prime|warrior|titan|spider|brute|ghost|anansi|trotro|bat|queen|addo)$/) && (newData.val().matches(/^(screen|bot|cyclops|die)$/) || root.child('wallets/' + $uid + '/owned/' + newData.val()).val() === true || (newData.val().matches(/^(prime|warrior|titan|spider|brute|ghost)$/) && now < 1792195200000))"
              },
              "wear": {
                ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z]+(,[a-z]+){0,2}$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "status": {
            ".write": "auth != null && data.parent().child('players').hasChild(auth.uid)",
            ".validate": "newData.isString() && ((!data.exists() && newData.val() === 'waiting') || (data.exists() && data.val() !== 'abandoned' && ((newData.val() === 'playing' && data.parent().child('hostId').val() === auth.uid) || (newData.val() === 'abandoned' && data.val() === 'playing'))))"
          },
          "startedAt": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && data.parent().child('players').hasChild(auth.uid)",
            ".validate": "newData.isNumber()"
          },
          "leftBy": {
            ".write": "auth != null && !data.exists() && data.parent().child('players').hasChild(auth.uid)",
            ".validate": "newData.isString()"
          },
          "endReason": {
            ".write": "auth != null && !data.exists() && data.parent().child('players').hasChild(auth.uid)",
            ".validate": "newData.val() === 'left' || newData.val() === 'disconnected'"
          },
          "endedAt": {
            ".write": "auth != null && !data.exists() && data.parent().child('players').hasChild(auth.uid)",
            ".validate": "newData.isNumber()"
          },
          "state": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && data.parent().child('players').hasChild(auth.uid) && !newData.child('found').exists() && !newData.child('ready').exists() && !newData.child('progress').exists() && !newData.child('solved').exists()",
            "found": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)"
              }
            },
            "ready": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)",
                ".validate": "newData.isBoolean()"
              }
            },
            "progress": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)"
              }
            },
            "solved": {
              "$r": {
                ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)"
              }
            },
            "live": {
              ".write": "auth != null && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)"
            }
          },
          "voice": {
            ".write": "auth != null && !newData.exists() && data.parent().child('hostId').val() === auth.uid",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)",
              ".validate": "newData.hasChildren(['a', 't', 'n', 'd'])",
              "a": {
                ".validate": "newData.isString() && newData.val().length <= 160000"
              },
              "t": {
                ".validate": "newData.isString() && newData.val().beginsWith('audio/') && newData.val().length <= 48"
              },
              "n": {
                ".validate": "newData.isNumber()"
              },
              "d": {
                ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 11000"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "react": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('matches/' + $game + '/' + $code).child('players').hasChild(auth.uid)",
              ".validate": "newData.hasChildren(['k', 'n'])",
              "k": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "n": {
                ".validate": "newData.isNumber()"
              },
              "at": {
                ".validate": "newData.isString() && root.child('matches/' + $game + '/' + $code).child('players').hasChild(newData.val())"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "noWatch": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && data.parent().child('status').val() === 'waiting'",
            ".validate": "newData.val() === true"
          },
          "watchers": {
            ".write": "auth != null && !newData.exists() && data.parent().child('hostId').val() === auth.uid",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('matches/' + $game + '/' + $code + '/status').exists() && root.child('matches/' + $game + '/' + $code + '/status').val() !== 'abandoned' && root.child('matches/' + $game + '/' + $code + '/noWatch').val() !== true && !root.child('matches/' + $game + '/' + $code + '/players').hasChild(auth.uid)))",
              ".validate": "newData.hasChildren(['name', 'at'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "look": {
                ".validate": "newData.isString() && newData.val().matches(/^(screen|bot|cyclops|die|prime|warrior|titan|spider|brute|ghost|anansi|trotro|bat|queen|addo)$/) && (newData.val().matches(/^(screen|bot|cyclops|die)$/) || root.child('wallets/' + $uid + '/owned/' + newData.val()).val() === true || (newData.val().matches(/^(prime|warrior|titan|spider|brute|ghost)$/) && now < 1792195200000))"
              },
              "wear": {
                ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[a-z]+(,[a-z]+){0,2}$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "wreact": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('matches/' + $game + '/' + $code + '/watchers').hasChild(auth.uid)",
              ".validate": "newData.hasChildren(['k', 'n'])",
              "k": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "n": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "wallets": {
      ".read": "auth != null && auth.token.email === 'emmanuelasaber@gmail.com' && auth.token.email_verified === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (auth.token.email === 'emmanuelasaber@gmail.com' && auth.token.email_verified === true && data.exists()))",
        ".validate": "newData.hasChild('chips') && newData.child('chips').isNumber() && newData.child('chips').val() >= 0 && (newData.child('chips').val() <= (data.exists() ? data.child('chips').val() : 0) + 600 || (auth.token.email === 'emmanuelasaber@gmail.com' && auth.token.email_verified === true && newData.child('chips').val() <= data.child('chips').val() + 10000))",
        "chips": {
          ".validate": "newData.isNumber()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
        },
        "seen": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "gifts": {
          "$id": {
            ".validate": "$id.length <= 40 && newData.hasChildren(['n', 'msg', 'at']) && (data.exists() ? newData.child('n').val() === data.child('n').val() && newData.child('msg').val() === data.child('msg').val() && newData.child('at').val() === data.child('at').val() : (auth.token.email === 'emmanuelasaber@gmail.com' && auth.token.email_verified === true))",
            "n": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000" },
            "msg": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "at": { ".validate": "newData.isNumber()" },
            "seen": { ".validate": "newData.val() === true" },
            "$other": { ".validate": false }
          }
        },
        "bought": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "first": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() === data.val())"
        },
        "owned": {
          "$look": {
            ".validate": "newData.val() === true && (data.exists() || (auth.token.email === 'emmanuelasaber@gmail.com' && auth.token.email_verified === true) || ($look === 'towercrown' && newData.parent().parent().child('tower/champ').val() === true) || ($look.matches(/^(prime|warrior|titan|spider|brute|ghost)$/) && now < 1792195200000) || (newData.parent().parent().child('bought').val() === $look && (($look.matches(/^(snapback|kufi|ghana|football|trash|chopbar|pidgin|church|gamenight)$/) && (data.parent().parent().child('chips').val() - newData.parent().parent().child('chips').val()) === 200) || ($look.matches(/^(slipper|balloon|pie|fanice|kenkey)$/) && (data.parent().parent().child('chips').val() - newData.parent().parent().child('chips').val()) === 250) || ($look.matches(/^(warrior)$/) && (data.parent().parent().child('chips').val() - newData.parent().parent().child('chips').val()) === 300) || ($look.matches(/^(prime|titan|trotro|kente|fugu|faces)$/) && (data.parent().parent().child('chips').val() - newData.parent().parent().child('chips').val()) === 400) || ($look.matches(/^(spider|anansi|jersey|tux)$/) && (data.parent().parent().child('chips').val() - newData.parent().parent().child('chips').val()) === 500) || ($look.matches(/^(brute|bat|queen|crown)$/) && (data.parent().parent().child('chips').val() - newData.parent().parent().child('chips').val()) === 600) || ($look.matches(/^(ghost|addo|gold)$/) && (data.parent().parent().child('chips').val() - newData.parent().parent().child('chips').val()) === 800))))"
          }
        },
        "paid": {
          "$match": {
            ".validate": "newData.hasChildren(['d', 't']) && newData.child('d').isString() && newData.child('d').val().length <= 10 && newData.child('t').isNumber() && newData.child('t').val() >= 0 && newData.child('t').val() <= 600",
            "r": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "w": { ".validate": "newData.val() === true" },
            "d": { ".validate": true },
            "t": { ".validate": true },
            "$other": { ".validate": false }
          }
        },
        "missions": {
          ".validate": "newData.hasChild('w')",
          "w": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "n": {
            "$id": { ".validate": "$id.matches(/^[a-z0-9]{2,16}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" }
          },
          "s": {
            "$id": {
              ".validate": "$id.matches(/^[a-z0-9]{2,16}$/)",
              "$k": { ".validate": "$k.matches(/^[a-z0-9]{2,20}$/) && newData.val() === true" }
            }
          },
          "got": {
            "$id": { ".validate": "$id.matches(/^[a-z0-9]{2,16}$/) && newData.val() === true && (data.exists() || newData.parent().parent().parent().child('chips').val() <= (data.parent().parent().parent().child('chips').exists() ? data.parent().parent().parent().child('chips').val() : 0) + 120)" }
          },
          "$other": { ".validate": false }
        },
        "tower": {
          ".validate": "newData.hasChildren(['s', 'at', 'hearts', 'best'])",
          "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "at": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "hearts": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
          "best": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "k": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "champ": { ".validate": "newData.val() === true && newData.parent().child('got/10').val() === true" },
          "got": {
            "$floor": { ".validate": "$floor.matches(/^([1-9]|10)$/) && newData.val() === true && (data.exists() || newData.parent().parent().parent().child('chips').val() <= (data.parent().parent().parent().child('chips').exists() ? data.parent().parent().parent().child('chips').val() : 0) + 300)" }
          },
          "$other": { ".validate": false }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "debts": {
      "$id": {
        ".read": "auth != null && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && $id.length <= 200 && newData.child('from').val() !== newData.child('to').val() && (newData.child('from').val() === auth.uid || newData.child('to').val() === auth.uid) && $id.beginsWith(newData.child('game').val() + '_' + newData.child('code').val() + '_') && $id.endsWith('_' + newData.child('from').val() + '_' + newData.child('to').val()) && root.child('matches/' + newData.child('game').val() + '/' + newData.child('code').val()).child('players').hasChild(newData.child('from').val()) && root.child('matches/' + newData.child('game').val() + '/' + newData.child('code').val()).child('players').hasChild(newData.child('to').val()) && root.child('matches/' + newData.child('game').val() + '/' + newData.child('code').val()).child('stake/text').val() === newData.child('stake').val()",
        ".validate": "newData.hasChildren(['from', 'to', 'fromName', 'toName', 'stake', 'game', 'code', 'at'])",
        "from": { ".validate": "newData.isString()" },
        "to": { ".validate": "newData.isString()" },
        "fromName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
        "toName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
        "stake": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 32" },
        "part": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 4" },
        "game": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9]{2,20}$/)" },
        "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{4}$/)" },
        "at": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "paid": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.parent().parent().child('from').val() === $uid || data.parent().parent().child('to').val() === $uid)",
            ".validate": "newData.val() === true"
          }
        },
        "$other": { ".validate": false }
      }
    },
    "owes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (!data.exists() && (root.child('debts/' + $id + '/from').val() === auth.uid || root.child('debts/' + $id + '/to').val() === auth.uid) && (root.child('debts/' + $id + '/from').val() === $uid || root.child('debts/' + $id + '/to').val() === $uid)))",
          ".validate": "newData.val() === true"
        }
      }
    }
  }
}
