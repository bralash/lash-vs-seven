{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/wordhunt.html",
        "destination": "/wordhunt",
        "type": 301
      },
      {
        "source": "/anagram.html",
        "destination": "/anagram",
        "type": 301
      },
      {
        "source": "/tictactoe.html",
        "destination": "/tictactoe",
        "type": 301
      },
      {
        "source": "/connect4.html",
        "destination": "/connect4",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
