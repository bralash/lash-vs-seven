{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/wordhunt.html",
        "destination": "/wordhunt",
        "type": 301
      },
      {
        "source": "/anagram.html",
        "destination": "/anagram",
